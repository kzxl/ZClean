<UserControl x:Class="ZeroClean.UI.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZeroClean.UI.Converters"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Selection Controls -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0: Quick Presets & Reclaimable Stats -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Presets Group -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Presets:" Foreground="{StaticResource TextMutedBrush}" 
                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <edit:SimpleButton Content="🟢 Safe Clean" Command="{Binding ApplyPresetCommand}" CommandParameter="Safe"
                                           Variant="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0"/>
                        <edit:SimpleButton Content="💻 Dev Workstation" Command="{Binding ApplyPresetCommand}" CommandParameter="Dev"
                                           Variant="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0"/>
                        <edit:SimpleButton Content="🔥 Select All" Command="{Binding ApplyPresetCommand}" CommandParameter="All"
                                           Variant="Secondary" Height="26" Padding="10,0" Margin="0,0,6,0"/>
                        <edit:SimpleButton Content="⚪ Clear" Command="{Binding DeselectAllCommand}" 
                                           Variant="Secondary" Height="26" Padding="8,0"/>
                    </StackPanel>

                    <!-- Reclaimable Metrics Badge -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Reclaimable: " Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalReclaimableBytes, Converter={StaticResource BytesConverter}}" 
                                   Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" (" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalReclaimableFiles}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text=" items)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Row 1: Category Filter Pills -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                    <TextBlock Text="Filter:" Foreground="{StaticResource TextMutedBrush}" 
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <edit:SimpleButton Content="All Rules" Command="{Binding SelectRuleCategoryCommand}" CommandParameter="All"
                                       Variant="Secondary" Height="24" Padding="10,0" Margin="0,0,6,0"/>
                    <edit:SimpleButton Content="🖥️ System &amp; Temp" Command="{Binding SelectRuleCategoryCommand}" CommandParameter="System"
                                       Variant="Secondary" Height="24" Padding="10,0" Margin="0,0,6,0"/>
                    <edit:SimpleButton Content="🌐 Web Browsers" Command="{Binding SelectRuleCategoryCommand}" CommandParameter="Browsers"
                                       Variant="Secondary" Height="24" Padding="10,0" Margin="0,0,6,0"/>
                    <edit:SimpleButton Content="📦 Development" Command="{Binding SelectRuleCategoryCommand}" CommandParameter="Development"
                                       Variant="Secondary" Height="24" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rules List -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <ListBox ItemsSource="{Binding FilteredRules}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     TextOptions.TextFormattingMode="Display"
                     RenderOptions.ClearTypeHint="Enabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2,0,2" Padding="12,10" CornerRadius="6"
                                Background="{StaticResource BgInputBrush}"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- ZeroUI CheckEdit Control -->
                                <edit:CheckEdit IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                BoxSize="18" Text=""
                                                VerticalAlignment="Center"/>

                                <!-- Rule Details -->
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" 
                                                   FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>

                                        <!-- Category Badge -->
                                        <feed:ZeroBadge BadgeText="{Binding Category}" Status="Accent" Margin="10,0,0,0" VerticalAlignment="Center"/>

                                        <!-- Risk Badge -->
                                        <feed:ZeroBadge BadgeText="{Binding RiskLevel}" Status="Online" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="11.5" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Scanned Size / Status -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ScannedSize, Converter={StaticResource BytesConverter}}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" 
                                               FontSize="13" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" 
                                               FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Bottom Action Bar & Progress -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Progress Indicator & Safety State -->
                <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <!-- Indeterminate Progress when Scanning/Cleaning -->
                    <ProgressBar Height="8" IsIndeterminate="True"
                                 Background="#262A44" Foreground="{StaticResource PrimaryAccentBrush}" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"/>
                    
                    <!-- Ready Safety Indicator when Idle -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisConverter}}">
                        <feed:ZeroBadge BadgeText="Safe Barrier Active" Status="Online" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Simulate before cleaning to review item purge count without altering disk contents." 
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Action Buttons: Scan, Simulate, Clean -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <edit:SimpleButton Content="🔍 Scan System" Command="{Binding ScanCommand}" 
                                       Variant="Primary" Height="34" Padding="16,0" Margin="0,0,8,0"/>
                    <edit:SimpleButton Content="🛡️ Simulate Clean" Command="{Binding SimulateCleanCommand}" 
                                       Variant="Secondary" Height="34" Padding="14,0" Margin="0,0,8,0"/>
                    <edit:SimpleButton Content="🧹 Clean Now" Command="{Binding LiveCleanCommand}" 
                                       Variant="Danger" Height="34" Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
