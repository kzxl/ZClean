<UserControl x:Class="ZeroClean.UI.Views.DiskAnalyzerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZeroClean.UI.Converters"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Storage Sentinel &amp; TreeMap Explorer" Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <feed:ZeroBadge BadgeText="Live Telemetry" Status="Online" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <feed:ZeroBadge BadgeText="Squarified Treemap" Status="Accent" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Continuous volume monitoring and interactive hierarchical disk space treemap breakdown (WizTree algorithm)." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <!-- Actions & Mode Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <edit:SimpleButton Content="{Binding IsTreeMapMode, Converter={x:Null}, StringFormat='🗺️ Toggle View'}"
                                       Command="{Binding ToggleDiskViewModeCommand}"
                                       Variant="Secondary" Height="32" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <edit:SimpleButton Content="🔄 Refresh Drives" Command="{Binding RefreshDrivesCommand}"
                                       Variant="Secondary" Height="32" Padding="14,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mode 1: Drives List View -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14"
                Visibility="{Binding IsTreeMapMode, Converter={StaticResource InverseBoolToVisConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="16" CornerRadius="8"
                                    Background="{StaticResource BgInputBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Drive Header -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="💾" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding DriveName}" Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding VolumeLabel, StringFormat=' ({0})'}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                                            <feed:ZeroBadge BadgeText="{Binding DriveFormat}" Status="Accent" Margin="10,0,0,0" VerticalAlignment="Center"/>

                                            <!-- Dynamic Margin Status Badge -->
                                            <Border Background="{StaticResource BgSurfaceBrush}" BorderBrush="{Binding StatusColor}" BorderThickness="1"
                                                    CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusColor}" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding UsedPercentage, StringFormat={}{0:F1}% Used}" 
                                                   Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" FontSize="13.5"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- ZeroUI ProgressBarControl -->
                                    <edit:ProgressBarControl Grid.Row="1" Margin="0,12,0,10" Height="16"
                                                             Value="{Binding UsedPercentage, Mode=OneWay}" 
                                                             Maximum="100" ShowPercentage="True"/>

                                    <!-- Storage Metrics & Direct Action -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Free Headroom: " Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"/>
                                            <TextBlock Text="{Binding FreeBytes, Converter={StaticResource BytesConverter}}" 
                                                       Foreground="{StaticResource SuccessAccentBrush}" FontWeight="Bold" FontSize="12.5"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                            <TextBlock Text="Allocated: " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding UsedBytes, Converter={StaticResource BytesConverter}}" 
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text=" / " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                            <TextBlock Text="{Binding TotalBytes, Converter={StaticResource BytesConverter}}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                        </StackPanel>

                                        <!-- TreeMap Explorer Button -->
                                        <edit:SimpleButton Grid.Column="2" Content="🗺️ TreeMap Explorer" 
                                                           Command="{Binding DataContext.AnalyzeDriveTreeMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}"
                                                           Variant="Primary" Height="26" Padding="12,0" Margin="0,0,8,0" VerticalAlignment="Center"/>

                                        <!-- Quick Clean Button -->
                                        <edit:SimpleButton Grid.Column="3" Content="🧹 Clean This Drive" 
                                                           Command="{Binding DataContext.NavigateTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="0"
                                                           Variant="Secondary" Height="26" Padding="12,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Mode 2: Interactive TreeMap Explorer -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14"
                Visibility="{Binding IsTreeMapMode, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TreeMap Control Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <edit:SimpleButton Grid.Column="0" Content="← Back to Drives" 
                                       Command="{Binding ToggleDiskViewModeCommand}"
                                       Variant="Secondary" Height="28" Padding="12,0" Margin="0,0,12,0"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Target: " Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"/>
                        <TextBlock Text="{Binding TreeMapTargetDirectory}" Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" FontSize="12.5"/>
                        <TextBlock Text="  •  " Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"/>
                        <TextBlock Text="{Binding TreeMapBlocks.Count, StringFormat='{}{0} blocks rendered'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>

                    <edit:SimpleButton Grid.Column="2" Content="⚡ Re-Analyze" 
                                       Command="{Binding AnalyzeDriveTreeMapCommand}"
                                       CommandParameter="{Binding TreeMapTargetDirectory}"
                                       Variant="Primary" Height="28" Padding="12,0"/>
                </Grid>

                <!-- TreeMap Viewport (Squarified layout rendered into Viewbox) -->
                <Border Grid.Row="1" Background="#0C0D14" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                    <Viewbox Stretch="Uniform" Margin="4">
                        <ItemsControl ItemsSource="{Binding TreeMapBlocks}" Width="880" Height="420">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas Width="880" Height="420"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                                    <Setter Property="Width" Value="{Binding Width}"/>
                                    <Setter Property="Height" Value="{Binding Height}"/>
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="1" CornerRadius="3" Background="{Binding ColorHex}"
                                            BorderBrush="#40FFFFFF" BorderThickness="1"
                                            ToolTip="{Binding FullPath}">
                                        <Grid Margin="3" ClipToBounds="True">
                                            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="10.5" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FormattedSize}" Foreground="#F0F0F0" FontSize="9.5"/>
                                                <TextBlock Text="{Binding PercentOfTotal, StringFormat={}{0:F1}%}" Foreground="#D0D0D0" FontSize="8.5"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Viewbox>
                </Border>

                <!-- Legend & Technical Note -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <TextBlock Text="💡 Squarified Treemap (Bruls-Huizing-van Wijk algorithm) optimizes aspect ratios close to 1:1, highlighting large space hogs instantly."
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontStyle="Italic" HorizontalAlignment="Left"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

