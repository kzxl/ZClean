<UserControl x:Class="ZeroClean.UI.Views.UninstallerOverview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZeroClean.UI.Converters"
             xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Custom Card Style -->
        <Style x:Key="KpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <!-- Filter Pill Button Style -->
        <Style x:Key="FilterPillStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource BgHoverBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Top KPI Metrics Cards -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Search, Filter Chips & Action Bar -->
            <RowDefinition Height="*"/>    <!-- Row 2: Split Applications List & Inspector Panel -->
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!-- ROW 0: TOP KPI METRICS CARDS (4 CARDS)                         -->
        <!-- ============================================================== -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Installed Software -->
            <Border Grid.Column="0" Style="{StaticResource KpiCardStyle}" Margin="0,0,6,0" opt:RenderOptimizer.Elevation="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#1E2342" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="📦" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="INSTALLED APPS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalAppsCount, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Registered Windows packages" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 2: Total Storage Footprint -->
            <Border Grid.Column="1" Style="{StaticResource KpiCardStyle}" Margin="3,0,3,0" opt:RenderOptimizer.Elevation="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#142B3B" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="💾" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STORAGE OCCUPIED" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalAppsSizeFormatted}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8"/>
                        <TextBlock Text="Estimated disk space usage" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 3: Broken Uninstallers -->
            <Border Grid.Column="2" Style="{StaticResource KpiCardStyle}" Margin="3,0,3,0" opt:RenderOptimizer.Elevation="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#3B2618" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="BROKEN UNINSTALLERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding BrokenAppsCount, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock Text="Corrupt/missing uninstall entry" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card 4: Orphan AppData Leftovers -->
            <Border Grid.Column="3" Style="{StaticResource KpiCardStyle}" Margin="6,0,0,0" opt:RenderOptimizer.Elevation="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#163327" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock Text="🧹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ORPHAN LEFTOVERS" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding TotalLeftoverSizeFormatted}" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                        <TextBlock Text="{Binding TotalLeftoverCount, StringFormat='{}{0} residual AppData folders'}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!-- ROW 1: SEARCH, FILTER CHIPS & ACTION TOOLBAR                   -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,10"
                opt:RenderOptimizer.Elevation="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/> <!-- Search Box -->
                    <ColumnDefinition Width="*"/>   <!-- Filter Chips -->
                    <ColumnDefinition Width="Auto"/> <!-- Refresh & Leftovers Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Search Box with Search Icon -->
                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchAppText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{StaticResource BgInputBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1"
                             Padding="28,5,8,5" VerticalAlignment="Center" Height="30" FontSize="12">
                        <TextBox.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </TextBox.Resources>
                    </TextBox>
                    <TextBlock Text="🔍" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                    <!-- Placeholder text when empty -->
                    <TextBlock Text="Filter by app name or publisher..." Foreground="{StaticResource TextMutedBrush}"
                               FontSize="11.5" Margin="28,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchAppText}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Filter Chips & Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Button Content="All Software" Command="{Binding SetFilterModeCommand}" CommandParameter="All"
                            Style="{StaticResource FilterPillStyle}"/>
                    <Button Content="🐘 Large Apps (>500MB)" Command="{Binding SetFilterModeCommand}" CommandParameter="Large"
                            Style="{StaticResource FilterPillStyle}"/>
                    <Button Content="⚠️ Broken Entries" Command="{Binding SetFilterModeCommand}" CommandParameter="Broken"
                            Style="{StaticResource FilterPillStyle}"/>
                    <feed:ZeroBadge Count="{Binding FilteredApps.Count}" Status="Accent" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Refresh & Scan Leftovers -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <edit:SimpleButton Content="🔄 Reload Inventory" Command="{Binding LoadAppsCommand}"
                                       Variant="Secondary" Height="28" Padding="12,0" Margin="0,0,6,0"/>
                    <edit:SimpleButton Content="🧹 Scan Leftovers" Command="{Binding LoadLeftoversCommand}"
                                       Variant="Secondary" Height="28" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!-- ROW 2: MAIN SPLIT APPLICATIONS LIST & RESIDUAL INSPECTOR       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: Applications List + Lazy Loading Frosted Overlay -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="8" Margin="0,0,8,0">
                <Grid>
                    <!-- Actual Software ListBox with Virtualization Enabled -->
                    <ListBox ItemsSource="{Binding FilteredApps}" SelectedItem="{Binding SelectedApp}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             TextOptions.TextFormattingMode="Display"
                             RenderOptions.ClearTypeHint="Enabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2,0,2" Padding="10,8" CornerRadius="6"
                                        Background="{StaticResource BgInputBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- App Initial Circle Icon -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                Background="#2E3466" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding InitialLetter}" Foreground="#A5B4FC"
                                                       FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Application Info -->
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                            
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,3">
                                                <TextBlock Text="{Binding Publisher}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                                <TextBlock Text="{Binding DisplayVersion}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                            </StackPanel>

                                            <!-- Engine & Status Badges -->
                                            <StackPanel Orientation="Horizontal">
                                                <feed:ZeroBadge BadgeText="{Binding EngineType}" Status="Accent" Margin="0,0,6,0"/>
                                                <!-- Broken Badge -->
                                                <Border Background="#3B1818" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsBroken}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="BROKEN" Foreground="#EF4444" FontSize="9.5" FontWeight="Bold"/>
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Size Footprint -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding EstimatedSizeBytes, Converter={StaticResource BytesConverter}}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"
                                                       FontSize="12" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Disk Usage" Foreground="{StaticResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty List Feedback -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasNoApps, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="🔍" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="No applications found" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try clearing your search query or switching the filter pills above." Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- FROSTED LAZY LOADING OVERLAY -->
                    <Grid Background="#E60E101C" Visibility="{Binding IsLoadingApps, Converter={StaticResource BoolToVisConverter}}">
                        <Border Width="420" Padding="24,20" Background="#181A2A"
                                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                                CornerRadius="12" VerticalAlignment="Center" HorizontalAlignment="Center"
                                opt:RenderOptimizer.Elevation="4">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Scanning Installed Packages..." Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold" FontSize="15" HorizontalAlignment="Center"/>
                                <TextBlock Text="Enumerating 32-bit &amp; 64-bit Windows Registry hives (HKLM, HKCU, Wow6432Node) and discovering orphan AppData residuals in the background..."
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"
                                           TextAlignment="Center" Margin="0,6,0,16"/>
                                
                                <ProgressBar Height="6" IsIndeterminate="True" Margin="0,0,0,12"
                                             Background="#262A44" Foreground="{StaticResource PrimaryAccentBrush}" BorderThickness="0"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <feed:ZeroBadge BadgeText="Lazy Loading" Status="Accent" Margin="0,0,6,0"/>
                                    <TextBlock Text="Asynchronous background scan" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- RIGHT: Residuals & Leftovers Inspector Panel -->
            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid>
                    <!-- Empty State when no app is selected -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisConverter}, ConverterParameter=invert}">
                        <TextBlock Text="👆" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Select an Application" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="Click any application to inspect uninstall arguments, trace leftover registry keys, and simulate uninstallation."
                                   Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" MaxWidth="280"/>
                    </StackPanel>

                    <!-- Selected App Details & Tools (Clean 4-Row Grid) -->
                    <Grid Visibility="{Binding SelectedApp, Converter={StaticResource NullToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Row 0: Selected App Header -->
                            <RowDefinition Height="Auto"/> <!-- Row 1: Quick Action Buttons -->
                            <RowDefinition Height="Auto"/> <!-- Row 2: Broken Entry Warning & Fix (Conditional) -->
                            <RowDefinition Height="*"/>    <!-- Row 3: Traces & Orphan Folders Explorer -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Selected App Header Card -->
                        <Border Grid.Row="0" Background="{StaticResource BgInputBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding SelectedApp.DisplayName}" 
                                                   Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedApp.Publisher}" 
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedApp.EstimatedSizeBytes, Converter={StaticResource BytesConverter}}"
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Top"/>
                                </Grid>

                                <Separator Background="{StaticResource BorderSubtleBrush}" Margin="0,8,0,8"/>

                                <TextBlock Text="UNINSTALL COMMAND STRING" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold"/>
                                <Border Background="#12141F" CornerRadius="4" Padding="6,4" Margin="0,3,0,0" BorderBrush="#262A40" BorderThickness="1">
                                    <TextBox Text="{Binding SelectedApp.UninstallString, Mode=OneWay}" IsReadOnly="True"
                                             Foreground="#CBD5E1" FontSize="10.5" FontFamily="Consolas" Background="Transparent"
                                             BorderThickness="0" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Row 1: Quick Action Buttons -->
                        <Grid Grid.Row="1" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <edit:SimpleButton Grid.Column="0" Content="🔍 Trace Residuals" Command="{Binding ScanAppResidualsCommand}"
                                               Variant="Primary" Height="28" Margin="0,0,4,0"/>
                            <edit:SimpleButton Grid.Column="1" Content="🛡️ Simulate" Command="{Binding SimulateUninstallAppCommand}"
                                               Variant="Secondary" Height="28" Margin="2,0,2,0"/>
                            <edit:SimpleButton Grid.Column="2" Content="🗑️ Uninstall" Command="{Binding LiveUninstallAppCommand}"
                                               Variant="Danger" Height="28" Margin="4,0,0,0"/>
                        </Grid>

                        <!-- Row 2: Broken Entry Warning & Fix Button (Only visible when broken) -->
                        <Border Grid.Row="2" Margin="0,0,0,8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedApp.IsBroken}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <edit:SimpleButton Content="⚡ Purge Broken Registry Entry" Command="{Binding RemoveBrokenEntryCommand}"
                                               Variant="Danger" Height="28"/>
                        </Border>

                        <!-- Row 3: Residual Traces & Leftovers Tabs -->
                        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Section 1: Residual Registry Keys -->
                                <Border Background="#161827" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Registry Residuals" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                            <feed:ZeroBadge Count="{Binding ActiveResidualAnalysis.RegistryKeysFound.Count}" Status="Accent" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding ActiveResidualAnalysis.RegistryKeysFound}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{StaticResource SecondaryAccentBrush}" 
                                                               FontSize="10.5" FontFamily="Consolas" Margin="0,2,0,2" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Residual Directories -->
                                <Border Background="#161827" CornerRadius="6" Padding="10" Margin="0,0,0,10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Residual Directories" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                            <feed:ZeroBadge Count="{Binding ActiveResidualAnalysis.DirectoriesFound.Count}" Status="Accent" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding ActiveResidualAnalysis.DirectoriesFound}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,2,0,2" Padding="6,4" Background="#1D2034" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding FolderPath}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding EstimatedSizeBytes, Converter={StaticResource BytesConverter}}"
                                                                       Foreground="{StaticResource SuccessAccentBrush}" FontSize="10.5" FontWeight="SemiBold" Margin="6,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: Orphan AppData Leftovers -->
                                <Border Background="#161827" CornerRadius="6" Padding="10"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="Detected Orphan AppData Leftovers" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="12"/>
                                                <feed:ZeroBadge Count="{Binding LeftoverFolders.Count}" Status="Online" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="⚡ Purge Checked Safe"
                                                    Command="{Binding PurgeSafeLeftoversCommand}"
                                                    ToolTip="Safely removes verified residual directories with Safe confidence."
                                                    Style="{StaticResource PrimaryActionButtonStyle}"
                                                    Background="#1B5E20" BorderBrush="#00E676" FontSize="10.5" Padding="10,4"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding LeftoverFolders}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,3,0,3" Padding="8,6" Background="#1D2034" CornerRadius="4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <edit:CheckEdit Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding FolderName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold"/>
                                                                    <!-- Confidence Badge -->
                                                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="3" VerticalAlignment="Center"
                                                                            ToolTip="{Binding ConfidenceReason}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="#33FFAA00"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding Confidence}" Value="Safe">
                                                                                        <Setter Property="Background" Value="#2200E676"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding Confidence}" Value="HighRisk">
                                                                                        <Setter Property="Background" Value="#33FF5252"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <TextBlock FontSize="8.5" FontWeight="Bold">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Text" Value="QUESTIONABLE"/>
                                                                                    <Setter Property="Foreground" Value="#FFAA00"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding Confidence}" Value="Safe">
                                                                                            <Setter Property="Text" Value="✓ SAFE"/>
                                                                                            <Setter Property="Foreground" Value="#00E676"/>
                                                                                        </DataTrigger>
                                                                                        <DataTrigger Binding="{Binding Confidence}" Value="HighRisk">
                                                                                            <Setter Property="Text" Value="⚠ HIGH RISK"/>
                                                                                            <Setter Property="Foreground" Value="#FF5252"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding FolderPath}" Foreground="{StaticResource TextMutedBrush}" FontSize="9.5" TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding EstimatedSizeBytes, Converter={StaticResource BytesConverter}}"
                                                                       Foreground="{StaticResource SuccessAccentBrush}" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0"/>
                                                            <Button Grid.Column="3" Content="🗑️ Purge"
                                                                    Command="{Binding DataContext.PurgeSelectedLeftoverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource FilterPillStyle}" Margin="0"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
