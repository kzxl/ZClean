<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:ZeroClean.UI.Converters">

    <!-- Design Tokens per E:\16. AgentOption\standards\csharp\wpf-ui.md -->
    <Color x:Key="ColorBgDark">#11131F</Color>
    <Color x:Key="ColorBgCard">#181A28</Color>
    <Color x:Key="ColorBgInput">#1D2034</Color>
    <Color x:Key="ColorBgSurface">#1D2034</Color>
    <Color x:Key="ColorBgHover">#262A44</Color>
    <Color x:Key="ColorBgActive">#32385C</Color>
    <Color x:Key="ColorBorderDefault">#2E344E</Color>
    <Color x:Key="ColorBorderSubtle">#23273C</Color>
    <Color x:Key="ColorPrimaryAccent">#818CF8</Color>
    <Color x:Key="ColorPrimaryAccentDark">#6366F1</Color>
    <Color x:Key="ColorSecondaryAccent">#A78BFA</Color>
    <Color x:Key="ColorTextPrimary">#F1F5F9</Color>
    <Color x:Key="ColorTextSecondary">#94A3B8</Color>
    <Color x:Key="ColorTextMuted">#64748B</Color>
    <Color x:Key="ColorSuccessAccent">#A6E3A1</Color>
    <Color x:Key="ColorDangerAccent">#F38BA8</Color>
    <Color x:Key="ColorWarningAccent">#F9E2AF</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource ColorBgDark}"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource ColorBgCard}"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource ColorBgInput}"/>
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{StaticResource ColorBgSurface}"/>
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource ColorBgHover}"/>
    <SolidColorBrush x:Key="BgActiveBrush" Color="{StaticResource ColorBgActive}"/>
    <SolidColorBrush x:Key="BorderDefaultBrush" Color="{StaticResource ColorBorderDefault}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource ColorPrimaryAccent}"/>
    <SolidColorBrush x:Key="PrimaryAccentDarkBrush" Color="{StaticResource ColorPrimaryAccentDark}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource ColorSecondaryAccent}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorTextPrimary}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorTextSecondary}"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource ColorTextMuted}"/>
    <SolidColorBrush x:Key="SuccessAccentBrush" Color="{StaticResource ColorSuccessAccent}"/>
    <SolidColorBrush x:Key="DangerAccentBrush" Color="{StaticResource ColorDangerAccent}"/>
    <SolidColorBrush x:Key="WarningAccentBrush" Color="{StaticResource ColorWarningAccent}"/>

    <!-- Global Converters for Application-Wide Use -->
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    <converters:BytesToHumanConverter x:Key="BytesConverter"/>
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
    <converters:NullToVisibilityConverter x:Key="NullToVisConverter"/>

    <!-- Global Font -->
    <FontFamily x:Key="AppFont">Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>

    <!-- Button: Modern Default -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource BgCardBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource BgActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: Primary Accent -->
    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryAccentDarkBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#4338CA"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Button: Danger Action -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
        <Setter Property="Background" Value="#381E2B"/>
        <Setter Property="Foreground" Value="{StaticResource DangerAccentBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource DangerAccentBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#E06C75"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CheckBox Modern -->
    <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="chkBox" Width="18" Height="18" CornerRadius="4"
                                Background="{StaticResource BgInputBrush}"
                                BorderBrush="{StaticResource BorderDefaultBrush}"
                                BorderThickness="1.2" Margin="0,0,8,0">
                            <Path x:Name="checkMark" Visibility="Collapsed"
                                  Data="M 3,8 L 7,12 L 15,4"
                                  Stroke="{StaticResource PrimaryAccentBrush}"
                                  StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="chkBox" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                            <Setter TargetName="chkBox" Property="Background" Value="{StaticResource BgHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="chkBox" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom Modern ProgressBar -->
    <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Background" Value="{StaticResource BgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
