<Window x:Class="ZeroClean.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ZeroClean.UI.Views"
        xmlns:components="clr-namespace:ZeroClean.UI.Views.Components"
        xmlns:vm="clr-namespace:ZeroClean.UI.ViewModels"
        xmlns:zero="clr-namespace:ZeroUI.Wpf.Theme;assembly=ZeroUI.Wpf"
        xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf"
        xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf"
        xmlns:nav="clr-namespace:ZeroUI.Wpf.Navigation;assembly=ZeroUI.Wpf"
        xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
        Title="ZeroClean — Sovereign Zero Universe System Optimizer" 
        Height="800" Width="1200" MinHeight="550" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <!-- Master Enterprise 2-Column Grid -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> <!-- SideNav Left Navigation Rail -->
            <ColumnDefinition Width="*"/>    <!-- Master Content Workspace -->
        </Grid.ColumnDefinitions>

        <!-- ZeroUI Sidebar Navigation -->
        <nav:SideNav x:Name="MainNav" Grid.Column="0"
                     BrandTitle="ZeroClean" BrandSubtitle="Zero Universe Suite" BrandLogo="⚡"
                     Width="230"/>

        <!-- Master Content Workspace -->
        <Grid Grid.Column="1" Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Section Header Bar -->
                <RowDefinition Height="Auto"/> <!-- In-Window Notification InfoBar -->
                <RowDefinition Height="*"/>    <!-- Active Content View -->
                <RowDefinition Height="Auto"/> <!-- Footer Status Bar -->
            </Grid.RowDefinitions>

            <!-- Top Section Header Bar -->
            <Border Grid.Row="0" Margin="0,0,0,12" Padding="14,10,14,12"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" opt:RenderOptimizer.Elevation="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Section Title & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActiveSectionTitle}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="{Binding ActiveSectionSubtitle}" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontSize="11.5" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Status Badges & Quick Indicators -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <feed:ZeroBadge BadgeText="Safe Barrier Active" Status="Online" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <feed:ZeroBadge BadgeText="Obsidian Dark" Status="Accent" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        
                        <Border Background="#1C2033" BorderBrush="#2E344E" BorderThickness="1"
                                CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="v2.0 Sovereign" Foreground="{DynamicResource PrimaryAccentBrush}" 
                                       FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- In-Window InfoBar Notification -->
            <components:InfoBar Grid.Row="1" Margin="0,0,0,10"
                                Visibility="{Binding IsInfoBarVisible, Converter={StaticResource BoolToVisConverter}}"/>

            <!-- Active Content View -->
            <Grid Grid.Row="2">
                <views:CleanerView x:Name="ViewCleaner" Visibility="Visible"/>
                <views:AdvisorView x:Name="ViewAdvisor" Visibility="Collapsed"/>
                <views:UninstallerOverview x:Name="ViewUninstaller" Visibility="Collapsed"/>
                <views:DiskAnalyzerView x:Name="ViewAnalyzer" Visibility="Collapsed"/>
                <views:AdvancedToolsView x:Name="ViewTools" Visibility="Collapsed"/>
            </Grid>

            <!-- Footer Status Bar -->
            <Border Grid.Row="3" Margin="0,10,0,0" Padding="12,6"
                    Background="{DynamicResource BgCardBrush}"
                    BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🛡️ " FontSize="11" VerticalAlignment="Center"/>
                        <TextBlock Text="Safety Barrier: Dry-Run Protected (Explicit confirmation required for live deletion)" 
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡ Direct3D Hardware Accelerated • ZeroUI v1.5.0 • 16 Rules Active" 
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
