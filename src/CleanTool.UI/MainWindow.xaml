<Window x:Class="CleanTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CleanTool.UI.Views"
        xmlns:components="clr-namespace:CleanTool.UI.Views.Components"
        xmlns:vm="clr-namespace:CleanTool.UI.ViewModels"
        Title="CleanTool — Modern System Optimizer" 
        Height="720" Width="1000" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Tabs -->
            <RowDefinition Height="Auto"/> <!-- InfoBar Notification -->
            <RowDefinition Height="*"/>    <!-- Content View -->
        </Grid.RowDefinitions>

        <!-- Top Header & Navigation -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" 
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌌" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="CleanTool" Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="Bold" FontSize="18"/>
                        <TextBlock Text="Universe System Optimizer" Foreground="{StaticResource TextMutedBrush}" 
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="⚡ Cleaner" IsChecked="{Binding SelectedTabIndex, Converter={x:Null}}"
                                 Click="OnCleanerTabClicked"
                                 x:Name="TabCleaner" IsThreeState="False"
                                 Style="{x:Null}" Margin="0,0,10,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="tabBorder" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                                        CornerRadius="6" Padding="16,8" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#262A44"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="📊 Disk Analyzer" Click="OnAnalyzerTabClicked"
                                 x:Name="TabAnalyzer"
                                 Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="tabBorder" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                                        CornerRadius="6" Padding="16,8" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#262A44"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- Right Quick Badge -->
                <Border Grid.Column="2" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                        CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="Safe Mode Active" Foreground="{StaticResource SuccessAccentBrush}" 
                               FontSize="11.5" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- In-Window InfoBar Notification -->
        <components:InfoBar Grid.Row="1" Visibility="{Binding IsInfoBarVisible, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <views:CleanerView x:Name="ViewCleaner" Visibility="Visible"/>
            <views:DiskAnalyzerView x:Name="ViewAnalyzer" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
