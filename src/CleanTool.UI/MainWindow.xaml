<Window x:Class="CleanTool.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CleanTool.UI.Views"
        xmlns:components="clr-namespace:CleanTool.UI.Views.Components"
        xmlns:vm="clr-namespace:CleanTool.UI.ViewModels"
        xmlns:zero="clr-namespace:ZeroUI.Wpf.Theme;assembly=ZeroUI.Wpf"
        xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf"
        xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf"
        Title="CleanTool — ZeroUI System Optimizer" 
        Height="720" Width="1020" MinHeight="500" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Tabs -->
            <RowDefinition Height="Auto"/> <!-- InfoBar Notification -->
            <RowDefinition Height="*"/>    <!-- Content View -->
        </Grid.RowDefinitions>

        <!-- Top Header & Navigation -->
        <Border Grid.Row="0" Margin="0,0,0,16" Padding="0,0,0,12" 
                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                opt:RenderOptimizer.Elevation="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" Background="{DynamicResource PrimaryAccentBrush}" CornerRadius="6" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"/>
                    </Border>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="CleanTool" Foreground="{DynamicResource TextPrimaryBrush}" 
                                       FontWeight="Bold" FontSize="18"/>
                            <Border Background="#1E284A" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="4" Margin="8,0,0,0" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="ZeroUI Powered" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Sovereign Universe Optimizer • Obsidian Dark" Foreground="{DynamicResource TextMutedBrush}" 
                                   FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="⚡ Cleaner" Click="OnCleanerTabClicked"
                                 x:Name="TabCleaner" IsThreeState="False"
                                 Style="{x:Null}" Margin="0,0,8,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="tabBorder" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                                        CornerRadius="6" Padding="14,7" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#262A44"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="🎯 Advisor" Click="OnAdvisorTabClicked"
                                 x:Name="TabAdvisor"
                                 Style="{x:Null}" Margin="0,0,8,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="tabBorder" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                                        CornerRadius="6" Padding="14,7" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#262A44"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="📦 Apps &amp; Leftovers" Click="OnUninstallerTabClicked"
                                 x:Name="TabUninstaller"
                                 Style="{x:Null}" Margin="0,0,8,0">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="tabBorder" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                                        CornerRadius="6" Padding="14,7" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#262A44"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>

                    <RadioButton Content="📊 Disk Analyzer" Click="OnAnalyzerTabClicked"
                                 x:Name="TabAnalyzer"
                                 Style="{x:Null}">
                        <RadioButton.Template>
                            <ControlTemplate TargetType="RadioButton">
                                <Border x:Name="tabBorder" Background="#181A28" BorderBrush="#2E344E" BorderThickness="1"
                                        CornerRadius="6" Padding="14,7" Cursor="Hand">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="tabBorder" Property="Background" Value="#262A44"/>
                                        <Setter TargetName="tabBorder" Property="BorderBrush" Value="{StaticResource PrimaryAccentBrush}"/>
                                        <Setter Property="Foreground" Value="{StaticResource PrimaryAccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </RadioButton.Template>
                    </RadioButton>
                </StackPanel>

                <!-- Right Quick Badge with ZeroUI ZeroBadge -->
                <feed:ZeroBadge Grid.Column="2" BadgeText="Safe Mode Active" Status="Online" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- In-Window InfoBar Notification -->
        <components:InfoBar Grid.Row="1" Visibility="{Binding IsInfoBarVisible, Converter={StaticResource BoolToVisConverter}}"/>

        <!-- Content Area -->
        <Grid Grid.Row="2">
            <views:CleanerView x:Name="ViewCleaner" Visibility="Visible"/>
            <views:AdvisorView x:Name="ViewAdvisor" Visibility="Collapsed"/>
            <views:UninstallerOverview x:Name="ViewUninstaller" Visibility="Collapsed"/>
            <views:DiskAnalyzerView x:Name="ViewAnalyzer" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
