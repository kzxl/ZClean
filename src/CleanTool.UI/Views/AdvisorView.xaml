<UserControl x:Class="CleanTool.UI.Views.AdvisorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CleanTool.UI.Converters"
             xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Health Score Header Card -->
            <RowDefinition Height="*"/>    <!-- Recommendations & Issues List -->
        </Grid.RowDefinitions>

        <!-- Top Health Score Card -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                opt:RenderOptimizer.Elevation="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Health Grade Badge -->
                <Border Width="64" Height="64" CornerRadius="32" Background="#1E284A"
                        BorderBrush="{StaticResource PrimaryAccentBrush}" BorderThickness="2"
                        Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HealthScore}" FontSize="18" FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryAccentBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding HealthGrade, StringFormat='Grade {0}'}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Status & Explanation -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="System Health &amp; Cleanliness Advisor" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="15" FontWeight="Bold"/>
                        <Border Background="#1C2E2A" BorderBrush="{StaticResource SuccessAccentBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="6,1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Heuristic Engine" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource SuccessAccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding HealthSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Run Assessment Action -->
                <Button Grid.Column="2" Content="⚡ Analyze Health" Command="{Binding RunAdvisorCommand}"
                        Style="{StaticResource ModernButtonStyle}" Height="34" Padding="16,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Recommendations Section -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Actionable Recommendations" Foreground="{StaticResource TextPrimaryBrush}"
                           FontWeight="Bold" FontSize="13.5" Margin="4,0,0,10"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6"
                                        Background="{StaticResource BgInputBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority Badge -->
                                        <Border Width="68" Height="26" CornerRadius="4" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2E344E"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                                            <Setter Property="Background" Value="#421C22"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                            <Setter Property="Background" Value="#3D351A"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Priority}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                <Setter Property="Foreground" Value="#F87171"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <!-- Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                                <Border Background="#262A44" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding ActionCategory}" Foreground="{StaticResource SecondaryAccentBrush}"
                                                               FontSize="10.5" FontWeight="Medium"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SuggestedCommand}" Foreground="{StaticResource PrimaryAccentBrush}"
                                                       FontSize="11" FontFamily="Consolas" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Savings Metric -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding EstimatedSavingsBytes, Converter={StaticResource BytesConverter}}"
                                                       Foreground="{StaticResource SuccessAccentBrush}" FontWeight="Bold"
                                                       FontSize="13.5" HorizontalAlignment="Right"/>
                                            <TextBlock Text="Potential" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10.5" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
