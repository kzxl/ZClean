<UserControl x:Class="CleanTool.UI.Views.AdvisorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CleanTool.UI.Converters"
             xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf"
             xmlns:ind="clr-namespace:ZeroUI.Wpf.Industrial;assembly=ZeroUI.Wpf">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Health Score Header Card -->
            <RowDefinition Height="*"/>    <!-- Recommendations & Issues List -->
        </Grid.RowDefinitions>

        <!-- Top Health Score Card with ZeroUI RadialGauge and StatisticControl -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="16" Margin="0,0,0,12"
                opt:RenderOptimizer.Elevation="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ZeroUI Industrial SCADA RadialGauge -->
                <ind:RadialGauge Value="{Binding HealthScore}" Minimum="0" Maximum="100"
                                 Title="Health" Unit="pts"
                                 Width="120" Height="120"
                                 VerticalAlignment="Center" Margin="0,0,16,0"/>

                <!-- Status & Explanation -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="System Health &amp; Cleanliness Advisor" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                        <feed:ZeroBadge BadgeText="Heuristic AI Engine" Status="Online" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        <feed:ZeroBadge BadgeText="{Binding HealthGrade, StringFormat='Grade {0}'}" Status="Accent" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="{Binding HealthSummary}" Foreground="{StaticResource TextSecondaryBrush}"
                               FontSize="12.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                               
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <edit:StatisticControl Title="Total Advice Items" Value="{Binding Recommendations.Count}" Width="150" Height="68" Margin="0,0,12,0"/>
                        <edit:StatisticControl Title="Health Score" Value="{Binding HealthScore}" Suffix="/ 100" Width="150" Height="68"/>
                    </StackPanel>
                </StackPanel>

                <!-- Run Assessment Action using SimpleButton -->
                <edit:SimpleButton Grid.Column="2" Content="⚡ Analyze Health" Command="{Binding RunAdvisorCommand}"
                                   Variant="Primary" Height="36" Padding="18,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Recommendations Section -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="4,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="Actionable Recommendations" Foreground="{StaticResource TextPrimaryBrush}"
                               FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <feed:ZeroBadge Count="{Binding Recommendations.Count}" Status="Accent" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Recommendations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="6"
                                        Background="{StaticResource BgInputBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Priority Badge -->
                                        <feed:ZeroBadge BadgeText="{Binding Priority}" Status="Warning" Margin="0,0,14,0" VerticalAlignment="Center"/>

                                        <!-- Advice Details -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource PrimaryAccentBrush}"
                                                           FontWeight="Bold" FontSize="12.5"/>
                                                <TextBlock Text=" • " Foreground="{StaticResource TextMutedBrush}" FontSize="12.5"/>
                                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" FontSize="13"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding SuggestedCommand, StringFormat='Command: cleantool {0}'}" 
                                                       Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas"
                                                       FontSize="10.5" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Estimated Impact / Size -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding EstimatedReclaimBytes, Converter={StaticResource BytesConverter}}"
                                                       Foreground="{StaticResource SuccessAccentBrush}" FontWeight="Bold"
                                                       FontSize="13" HorizontalAlignment="Right"/>
                                            <TextBlock Text="potential gain" Foreground="{StaticResource TextMutedBrush}"
                                                       FontSize="10.5" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
