<UserControl x:Class="CleanTool.UI.Views.CleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:CleanTool.UI.Converters">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Selection Controls -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Select All" Command="{Binding SelectAllCommand}" 
                            Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0" Margin="0,0,8,0"/>
                    <Button Content="Deselect All" Command="{Binding DeselectAllCommand}" 
                            Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,0"/>
                </StackPanel>

                <!-- Reclaimable Metrics Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Reclaimable: " Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="13" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalReclaimableBytes, Converter={StaticResource BytesConverter}}" 
                               Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock Text=" (" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding TotalReclaimableFiles}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text=" items)" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Rules List -->
        <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Rules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="4" Padding="12,10" CornerRadius="6"
                                    Background="{StaticResource BgInputBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection Checkbox -->
                                    <CheckBox IsChecked="{Binding IsSelected}" 
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              VerticalAlignment="Center"/>

                                    <!-- Rule Details -->
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontWeight="SemiBold" FontSize="13"/>

                                            <!-- Category Pill -->
                                            <Border Background="#262A44" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Category}" Foreground="{StaticResource SecondaryAccentBrush}" 
                                                           FontSize="10.5" FontWeight="Medium"/>
                                            </Border>

                                            <!-- Risk Pill -->
                                            <Border Background="#1C2E2A" CornerRadius="4" Padding="6,1" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding RiskLevel}" Foreground="{StaticResource SuccessAccentBrush}" 
                                                           FontSize="10.5" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" 
                                                   FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <!-- Scanned Size / Status -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                        <TextBlock Text="{Binding ScannedSize, Converter={StaticResource BytesConverter}}" 
                                                   Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" 
                                                   FontSize="13" HorizontalAlignment="Right"/>
                                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextMutedBrush}" 
                                                   FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Action Bar & Progress -->
        <Border Grid.Row="2" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status & Progress -->
                <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12" TextTrimming="CharacterEllipsis"/>
                    <ProgressBar Margin="0,6,0,0" Value="{Binding ProgressValue}" Maximum="100"
                                 Style="{StaticResource ModernProgressBarStyle}"/>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔍 Scan System" Command="{Binding ScanCommand}" 
                            Style="{StaticResource AccentButtonStyle}" Height="34" Padding="18,0" Margin="0,0,10,0"/>
                    <Button Content="🛡️ Simulate Clean" Command="{Binding SimulateCleanCommand}" 
                            Style="{StaticResource ModernButtonStyle}" Height="34" Padding="16,0"/>
                </StackPanel>

                <!-- Safety Notice -->
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" 
                           Text="🔒 Safe Dry-Run Mode Active: Real-time simulation only. No physical files on this machine will be deleted." 
                           Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,8,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
