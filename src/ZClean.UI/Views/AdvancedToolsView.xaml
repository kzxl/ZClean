<UserControl x:Class="ZClean.UI.Views.AdvancedToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:ZClean.UI.Converters"
             xmlns:edit="clr-namespace:ZeroUI.Wpf.Editors;assembly=ZeroUI.Wpf"
             xmlns:feed="clr-namespace:ZeroUI.Wpf.Feedback;assembly=ZeroUI.Wpf"
             xmlns:opt="clr-namespace:ZeroUI.Wpf.Rendering.Optimizer;assembly=ZeroUI.Wpf">
    <UserControl.Resources>
        <converters:BytesToHumanConverter x:Key="BytesConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Card -->
        <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,12" Margin="0,0,0,12"
                opt:RenderOptimizer.Elevation="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Advanced System Engineering &amp; Virtualization Tools" Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <feed:ZeroBadge BadgeText="Power Utilities" Status="Online" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Specialized deep tools: Large file hunter, WinSxS Component Store analysis, and WSL2/Docker virtual disk compactors." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <edit:SimpleButton Content="🔍 Scan Large Files" Command="{Binding ScanLargeFilesCommand}"
                                       Variant="Primary" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <edit:SimpleButton Content="⚙️ Analyze WinSxS" Command="{Binding AnalyzeDismCommand}"
                                       Variant="Secondary" Height="32" Padding="14,0" Margin="0,0,8,0"/>
                    <edit:SimpleButton Content="🐧 Scan WSL Disks" Command="{Binding ScanWslDisksCommand}"
                                       Variant="Secondary" Height="32" Padding="14,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3-Column Tool Panels Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/> <!-- Large Files Hunter -->
                <ColumnDefinition Width="2*"/> <!-- WinSxS & WSL2 -->
            </Grid.ColumnDefinitions>

            <!-- Left: Large Files Hunter Panel -->
            <Border Grid.Column="0" Background="{StaticResource BgCardBrush}"
                    BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="2,0,2,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title & Count -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Large Space Hogs (> 100MB)" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center"/>
                            <feed:ZeroBadge Count="{Binding FilteredLargeFiles.Count}" Status="Accent" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="User Profile Scope" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center"/>

                        <!-- Type Filter Pills -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,2" VerticalAlignment="Center">
                            <TextBlock Text="Type:" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <edit:SimpleButton Content="All" Command="{Binding SelectLargeFileTypeCommand}" CommandParameter="All"
                                               Variant="Secondary" Height="22" Padding="8,0" Margin="0,0,4,0"/>
                            <edit:SimpleButton Content="🎬 Media" Command="{Binding SelectLargeFileTypeCommand}" CommandParameter="Media"
                                               Variant="Secondary" Height="22" Padding="8,0" Margin="0,0,4,0"/>
                            <edit:SimpleButton Content="💿 Images" Command="{Binding SelectLargeFileTypeCommand}" CommandParameter="DiskImages"
                                               Variant="Secondary" Height="22" Padding="8,0" Margin="0,0,4,0"/>
                            <edit:SimpleButton Content="📦 Archives" Command="{Binding SelectLargeFileTypeCommand}" CommandParameter="Archives"
                                               Variant="Secondary" Height="22" Padding="8,0" Margin="0,0,4,0"/>
                            <edit:SimpleButton Content="⚙️ Installers" Command="{Binding SelectLargeFileTypeCommand}" CommandParameter="Installers"
                                               Variant="Secondary" Height="22" Padding="8,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Large Files Virtualized List -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredLargeFiles}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.CanContentScroll="True"
                             TextOptions.TextFormattingMode="Display"
                             RenderOptions.ClearTypeHint="Enabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="6"
                                        Background="{StaticResource BgInputBrush}"
                                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}"
                                                           FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                <feed:ZeroBadge BadgeText="{Binding Category}" Status="Accent" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FullPath}" Foreground="{StaticResource TextMutedBrush}" 
                                                       FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="300"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding SizeBytes, Converter={StaticResource BytesConverter}}"
                                                   Foreground="{StaticResource PrimaryAccentBrush}" FontWeight="Bold" 
                                                   FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0,10,0"/>

                                        <!-- Direct Item Actions -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <edit:SimpleButton Content="📁" ToolTip="Open folder in File Explorer"
                                                               Command="{Binding DataContext.OpenLargeFileFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Variant="Secondary" Height="26" Width="28" Padding="0" Margin="0,0,4,0"/>
                                            <edit:SimpleButton Content="🗑️" ToolTip="Delete this large file"
                                                               Command="{Binding DataContext.DeleteLargeFileCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                               CommandParameter="{Binding}"
                                                               Variant="Danger" Height="26" Width="28" Padding="0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: WinSxS & WSL2 Virtual Disks Panels -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- WinSxS DISM Status Card -->
                <Border Grid.Row="0" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12" Margin="0,0,0,8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                            <TextBlock Text="WinSxS Component Store" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <feed:ZeroBadge BadgeText="DISM Servicing" Status="Online" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="6" Padding="10"
                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Reported Size:" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{Binding DismReport.ComponentStoreSize, FallbackValue='Not analyzed'}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Actual Windows Footprint:" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{Binding DismReport.ActualSize, FallbackValue='Not analyzed'}" 
                                               Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="11.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <TextBlock Text="Superseded Packages:" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5"/>
                                    <TextBlock Text="{Binding DismReport.SupersededPackagesCount, FallbackValue='0'}" 
                                               Foreground="{StaticResource WarningAccentBrush}" FontWeight="Bold" FontSize="11.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock Text="Status:" Foreground="{StaticResource TextMutedBrush}" FontSize="11.5" VerticalAlignment="Center"/>
                                    <feed:ZeroBadge BadgeText="{Binding DismReport.IsCleanupRecommended, FallbackValue='Clean'}" 
                                                    Status="Accent" HorizontalAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- WSL2 & Docker Disks List -->
                <Border Grid.Row="1" Background="{StaticResource BgCardBrush}"
                        BorderBrush="{StaticResource BorderDefaultBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="WSL2 &amp; Docker Virtual Disks" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <feed:ZeroBadge Count="{Binding WslDisks.Count}" Status="Accent" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding WslDisks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6" Padding="8" CornerRadius="6"
                                                Background="{StaticResource BgInputBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DistroName}" Foreground="{StaticResource PrimaryAccentBrush}"
                                                               FontWeight="Bold" FontSize="12"/>
                                                    <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextMutedBrush}" 
                                                               FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" Foreground="{StaticResource SuccessAccentBrush}"
                                                           FontWeight="Bold" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
